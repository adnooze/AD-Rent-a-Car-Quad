---
import Layout from '../layouts/Layout.astro';
import { contact, vozila } from '../data/site.js';

const img = (file: string) => `/assets/img/${file}`;
const instaGallery = [
  { file: 'flyer-renta-car-ad.jpg', alt: 'Renta Car AD – iznajmi vozilo i kreni' },
  { file: 'vw-golf-variant.jpg', alt: 'Brendirani VW Golf Variant' },
  { file: 'voznja-audi.jpg', alt: 'Vožnja u Audiju' },
  { file: 'vw-golf-bijeli.jpg', alt: 'Bijeli VW Golf' },
];
---
<Layout
  title="AD Rent a Car & Quad Zenica | Iznajmljivanje automobila i kvadova 0–24"
  description="AD Rent a Car & Quad Zenica – veliki izbor automobila i kvadova po najpovoljnijim cijenama. Dostupni 0–24. Pozovite 062 919 010 (Viber, WhatsApp). Rent auta i za firme na virmansko plaćanje."
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-media">
      <img src={img('flota-zenica.jpg')} alt="Vozni park AD Rent a Car u centru Zenice – BMW kabriolet, Mercedes, VW i kvadovi" fetchpriority="high">
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><svg class="ic"><use href="#i-clock"/></svg> Dostupni 0–24 · Zenica</p>
        <h1 class="hero-title">
          <span class="line-1">Iznajmi vozilo</span>
          <span class="line-2">i kreni!</span>
        </h1>
        <p class="hero-sub">Veliki izbor automobila i kvadova, najpovoljnije cijene. Pouzdana vozila, povoljne cijene – vaša sloboda.</p>
        <div class="hero-actions">
          <a href="#rezervacija" class="btn btn-yellow btn-lg">Rezerviši vozilo <span class="btn-circle"><svg class="ic"><use href="#i-arrow"/></svg></span></a>
          <a href={contact.phoneHref} class="btn-ghost">
            <span class="ghost-ring"><svg class="ic"><use href="#i-phone"/></svg></span>
            {contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PONUDA + STATS -->
  <section class="section quality">
    <div class="container quality-grid">
      <div class="quality-copy reveal">
        <h2 class="h2">Odaberi iz naše<br><span class="y">ponude vozila</span></h2>
        <p class="lead">Raznovrstan vozni park za svaku potrebu i budžet – od gradskih automobila do premium limuzina, kabrioleta i kvadova.</p>
        <ul class="chip-list">
          <li><span class="chip-ic"><svg class="ic"><use href="#i-shield"/></svg></span><div><strong>Sigurna vozila</strong><small>Uredna i provjerena</small></div></li>
          <li><span class="chip-ic"><svg class="ic"><use href="#i-car"/></svg></span><div><strong>Širok izbor vozila</strong><small>Auta i kvadovi</small></div></li>
          <li><span class="chip-ic"><svg class="ic"><use href="#i-wallet"/></svg></span><div><strong>Povoljne cijene</strong><small>Najbolji omjer za novac</small></div></li>
        </ul>
      </div>
      <div class="quality-img reveal">
        <img src={img('vw-golf-bijeli.jpg')} alt="Bijeli VW Golf iz ponude AD Rent a Car Zenica" loading="lazy">
      </div>
    </div>
    <div class="container">
      <div class="stats reveal">
        <div class="stat"><svg class="ic"><use href="#i-clock"/></svg><div><strong>0–24</strong><small>Radno vrijeme</small></div></div>
        <div class="stat"><svg class="ic"><use href="#i-car"/></svg><div><strong>Auta + kvadovi</strong><small>Na jednom mjestu</small></div></div>
        <div class="stat"><svg class="ic"><use href="#i-file"/></svg><div><strong>Virman</strong><small>Plaćanje za firme</small></div></div>
        <div class="stat"><svg class="ic"><use href="#i-star"/></svg><div><strong>1.600+</strong><small>Pratilaca na Instagramu</small></div></div>
      </div>
    </div>
  </section>

  <!-- ŠTA DOBIJATE -->
  <section class="section perks">
    <div class="container perks-grid">
      <div class="reveal">
        <h2 class="h2 underline">Šta dobijate uz AD Rent a Car</h2>
        <ol class="perk-list">
          <li>
            <span class="perk-ic"><svg class="ic"><use href="#i-wallet"/></svg></span>
            <div><h3>1. Najpovoljnije cijene</h3><p>Jasne cijene bez iznenađenja – pitajte nas za ponudu.</p></div>
            <a href="#rezervacija" class="more">Upit <svg class="ic"><use href="#i-arrow"/></svg></a>
          </li>
          <li>
            <span class="perk-ic"><svg class="ic"><use href="#i-repeat"/></svg></span>
            <div><h3>2. Fleksibilno preuzimanje i povrat</h3><p>Prilagođavamo se vašem rasporedu – dostupni smo 0–24.</p></div>
            <a href="#kontakt" class="more">Kontakt <svg class="ic"><use href="#i-arrow"/></svg></a>
          </li>
          <li>
            <span class="perk-ic"><svg class="ic"><use href="#i-shield"/></svg></span>
            <div><h3>3. Pouzdana i sigurna vozila</h3><p>Sigurnost i udobnost na svakom kilometru.</p></div>
            <a href="#vozila" class="more">Vozila <svg class="ic"><use href="#i-arrow"/></svg></a>
          </li>
        </ol>
      </div>
      <div class="polaroids reveal" aria-hidden="true">
        <figure class="polaroid p1"><img src={img('mercedes-e-klasa.jpg')} alt="" loading="lazy"></figure>
        <figure class="polaroid p2"><img src={img('vw-golf-bijeli-2.jpg')} alt="" loading="lazy"></figure>
      </div>
    </div>
  </section>

  <!-- 3 KORAKA -->
  <section class="section steps-section">
    <div class="container">
      <h2 class="h2 center reveal">Rezerviši u <span class="y">3 laka koraka</span></h2>
      <div class="steps reveal">
        <div class="step">
          <span class="step-ic"><svg class="ic"><use href="#i-car"/></svg></span>
          <span class="step-num">1</span>
          <h3>Odaberi vozilo</h3>
          <p>Pogledaj ponudu i izaberi auto ili kvad za svoju priliku.</p>
        </div>
        <div class="step">
          <span class="step-ic"><svg class="ic"><use href="#i-chat"/></svg></span>
          <span class="step-num">2</span>
          <h3>Javi nam se</h3>
          <p>Pozovi ili piši na Viber / WhatsApp i dogovori termin.</p>
        </div>
        <div class="step">
          <span class="step-ic"><svg class="ic"><use href="#i-key"/></svg></span>
          <span class="step-num">3</span>
          <h3>Preuzmi i kreni</h3>
          <p>Preuzmi ključeve i uživaj u vožnji.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ZA SVAKU PRILIKU -->
  <section class="section journey">
    <div class="container journey-grid">
      <div class="journey-copy reveal">
        <h2 class="h2">Vozilo za<br><span class="y">svaku priliku</span></h2>
        <p>Za posao, odmor, vjenčanja i sve druge prilike – od kompaktnih gradskih automobila do premium limuzina i kvadova za avanturu.</p>
        <a href="#vozila" class="btn btn-dark">Pogledaj vozila <span class="btn-circle"><svg class="ic"><use href="#i-arrow"/></svg></span></a>
      </div>
      <div class="journey-visual reveal">
        <div class="yellow-block"></div>
        <img src={img('bmw-4-cabrio.jpg')} alt="Bijeli BMW Serije 4 kabriolet" loading="lazy">
      </div>
      <ul class="journey-list reveal">
        <li><span class="round-ic"><svg class="ic"><use href="#i-car"/></svg></span><div><strong>Gradski automobili</strong><small>Ekonomični i praktični za svaki dan.</small></div></li>
        <li><span class="round-ic"><svg class="ic"><use href="#i-briefcase"/></svg></span><div><strong>Premium i poslovna vozila</strong><small>Mercedes, BMW, Audi – udobnost i stil.</small></div></li>
        <li><span class="round-ic"><svg class="ic"><use href="#i-heart"/></svg></span><div><strong>Kabriolet za posebne dane</strong><small>Vjenčanja, proslave i ljetne vožnje.</small></div></li>
        <li><span class="round-ic"><svg class="ic"><use href="#i-mountain"/></svg></span><div><strong>Kvadovi</strong><small>Za avanturu u prirodi oko Zenice.</small></div></li>
      </ul>
    </div>
  </section>

  <!-- VOZNI PARK -->
  <section class="section fleet" id="vozila">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <h2 class="h2">Naš <span class="y">vozni park</span></h2>
          <p class="lead">Dio vozila iz naše ponude. Ponuda se redovno osvježava – pitajte nas šta je trenutno slobodno.</p>
        </div>
        <a href={contact.instagram} target="_blank" rel="noopener" class="btn btn-outline"><svg class="ic"><use href="#i-insta"/></svg> Sve novosti na Instagramu</a>
      </div>
      <div class="fleet-grid">
        {vozila.map((v) => (
          <article class="car-card reveal">
            <div class="car-img">
              <img src={img(v.img)} alt={v.alt} loading="lazy">
              {v.tag && <span class="tag">{v.tag}</span>}
            </div>
            <div class="car-body">
              <small>{v.category}</small>
              <h3>{v.title}</h3>
              <a class="car-cta" href="#rezervacija" data-car={v.name}>Pošalji upit <svg class="ic"><use href="#i-arrow"/></svg></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- KVADOVI BANNER -->
  <section class="adventure" id="kvadovi">
    <div class="adventure-media"><img src={img('kvad.jpg')} alt="Kvad u prirodi" loading="lazy"></div>
    <div class="container adventure-inner reveal">
      <p class="eyebrow"><svg class="ic"><use href="#i-mountain"/></svg> Iznajmljivanje kvadova</p>
      <h2 class="h2 light">Doživi svoju<br><span class="y">avanturu</span></h2>
      <p>Šume, brda i makadam oko Zenice čekaju. Iznajmi kvad i učini vikend nezaboravnim.</p>
      <a href="#rezervacija" class="btn btn-yellow" data-car="Kvad (ATV)">Rezerviši kvad <span class="btn-circle"><svg class="ic"><use href="#i-arrow"/></svg></span></a>
    </div>
  </section>

  <!-- ZA FIRME -->
  <section class="confidence" id="firme">
    <div class="container confidence-grid">
      <div class="reveal">
        <h2 class="h2 light">Vozite s<br><span class="y">povjerenjem</span></h2>
        <ul class="conf-list">
          <li><span class="sq-ic"><svg class="ic"><use href="#i-clock"/></svg></span><div><strong>Dostupnost i podrška 0–24</strong><small>Tu smo za vas u bilo koje doba.</small></div></li>
          <li><span class="sq-ic"><svg class="ic"><use href="#i-briefcase"/></svg></span><div><strong>Rent auta za firme</strong><small>Radimo i sa firmama na virmansko plaćanje.</small></div></li>
          <li><span class="sq-ic"><svg class="ic"><use href="#i-chat"/></svg></span><div><strong>Jednostavna rezervacija</strong><small>Jedan poziv ili poruka na Viber / WhatsApp.</small></div></li>
          <li><span class="sq-ic"><svg class="ic"><use href="#i-shield"/></svg></span><div><strong>Sigurna vozila</strong><small>Vaše vozilo, naš prioritet!</small></div></li>
        </ul>
      </div>
      <div class="confidence-img reveal">
        <img src={img('mercedes-e-klasa-enterijer.jpg')} alt="Enterijer Mercedes-Benz E-klase" loading="lazy">
      </div>
    </div>
  </section>

  <!-- INSTAGRAM / USPOMENE -->
  <section class="section memories">
    <div class="container memories-grid">
      <div class="reveal">
        <h2 class="h2">Uspomene<br><span class="y">s puta</span></h2>
        <p class="lead">Od porodičnih putovanja do poslovnih vožnji – mi smo tu za vas. Pratite novosti iz ponude na našem Instagramu.</p>
        <a href={contact.instagram} target="_blank" rel="noopener" class="btn btn-dark"><svg class="ic"><use href="#i-insta"/></svg> {contact.instagramHandle}</a>
      </div>
      <div class="insta-grid reveal">
        {instaGallery.map((g) => (
          <a href={contact.instagram} target="_blank" rel="noopener"><img src={img(g.file)} alt={g.alt} loading="lazy"></a>
        ))}
      </div>
    </div>
  </section>

  <!-- REZERVACIJA + KONTAKT -->
  <section class="help" id="kontakt">
    <div class="container help-grid">
      <div class="help-info reveal">
        <h2 class="h2 light">Trebate pomoć?<br><span class="y">Tu smo</span> za vas!</h2>
        <ul class="contact-list">
          <li><a href={contact.phoneHref}><span class="sq-ic"><svg class="ic"><use href="#i-phone"/></svg></span><div><small>Pozovite nas</small><strong>{contact.phone}</strong></div></a></li>
          <li><a href={contact.whatsapp} target="_blank" rel="noopener"><span class="sq-ic"><svg class="ic"><use href="#i-chat"/></svg></span><div><small>WhatsApp</small><strong>{contact.phoneIntl}</strong></div></a></li>
          <li><a href={contact.viber}><span class="sq-ic"><svg class="ic"><use href="#i-chat"/></svg></span><div><small>Viber</small><strong>{contact.phoneIntl}</strong></div></a></li>
          <li><a href={contact.instagram} target="_blank" rel="noopener"><span class="sq-ic"><svg class="ic"><use href="#i-insta"/></svg></span><div><small>Instagram</small><strong>{contact.instagramHandle}</strong></div></a></li>
          <li><div class="li-static"><span class="sq-ic"><svg class="ic"><use href="#i-clock"/></svg></span><div><small>Radno vrijeme</small><strong>0–24, svaki dan</strong></div></div></li>
          <li><div class="li-static"><span class="sq-ic"><svg class="ic"><use href="#i-pin"/></svg></span><div><small>Lokacija</small><strong>Zenica, Bosna i Hercegovina</strong></div></div></li>
        </ul>
      </div>

      <form class="booking reveal" id="rezervacija" novalidate>
        <h3>Brzi upit za rezervaciju</h3>
        <p class="form-note">Popunite polja i upit se šalje direktno na naš WhatsApp.</p>
        <div class="field">
          <label for="f-name">Ime i prezime</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Vaše ime">
        </div>
        <div class="field">
          <label for="f-car">Vozilo</label>
          <select id="f-car" name="car">
            <option value="Bilo koje slobodno vozilo">Bilo koje slobodno vozilo</option>
            {vozila.map((v) => <option>{v.name}</option>)}
          </select>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="f-from">Preuzimanje</label>
            <input id="f-from" name="from" type="date" required>
          </div>
          <div class="field">
            <label for="f-to">Povrat</label>
            <input id="f-to" name="to" type="date" required>
          </div>
        </div>
        <div class="field">
          <label for="f-note">Napomena <span class="opt">(opcionalno)</span></label>
          <textarea id="f-note" name="note" rows="3" placeholder="Npr. preuzimanje na adresi, plaćanje virmanom za firmu…"></textarea>
        </div>
        <p class="form-error" id="formError" role="alert" hidden></p>
        <button type="submit" class="btn btn-yellow btn-block">Pošalji upit na WhatsApp <span class="btn-circle"><svg class="ic"><use href="#i-send"/></svg></span></button>
        <a href={contact.phoneHref} class="form-alt">ili nas pozovite: <strong>{contact.phone}</strong></a>
      </form>
    </div>
  </section>

</Layout>
